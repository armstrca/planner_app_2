<div id="<%= dom_id page_template %>">
  <p>
    <strong>Name:</strong>
    <%= page_template.name %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= page_template.content %>
  </p>

  <p>
    <strong>page_template type:</strong>
    <%= page_template.type %>
  </p>

  <p>
    <strong>Is default:</strong>
    <%= page_template.is_default %>
  </p>

  <p>
    <strong>User:</strong>
    <%= page_template.user_id %>
  </p>

  <p>
    <strong>Planner:</strong>
    <%= page_template.planner_id %>
  </p>

</div>
