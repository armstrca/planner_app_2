<%= form_with(model: template) do |form| %>
  <% if template.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(template.errors.count, "error") %> prohibited this template from being saved:</h2>

      <ul>
        <% template.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_field :content %>
  </div>

  <div>
    <%= form.label :template_type, style: "display: block" %>
    <%= form.text_field :template_type %>
  </div>

  <div>
    <%= form.label :is_default, style: "display: block" %>
    <%= form.check_box :is_default %>
  </div>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

  <div>
    <%= form.label :planner_id, style: "display: block" %>
    <%= form.text_field :planner_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
