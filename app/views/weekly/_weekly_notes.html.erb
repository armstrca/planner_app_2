<%= javascript_include_tag "weekly_notes_calendar" %>
<div class="container mx-auto">
  <%= content_tag(:div, "", id:"app", style:"height: 100%, width: 100%; position: relative;", data: {
          controller: "react"
        })%>
  <div class="flex flex-col">
    <div class="text-center py-4" style="padding-bottom: 12px">
      <h1 class="text-2xl font-semibold" style="text-align-last: left">
        2024 February
      </h1>
      <div class="top-line" style="margin-top: 1px; margin-bottom: -8px"></div>
    </div>
    <div class="flex flex-row justify-between relative">
      <div class="vertical-line"></div>
      <div class="w-1/2 pr-2">
        <div class="canvas" style="height: 125px"></div>
        <div class="solid mb-2" style="padding-top: 0.5rem"></div>
        <div class="canvas" style="height: 90px"></div>
        <div class="solid-red mb-2" style="padding-top: 0.5rem"></div>
        <div class="canvas" style="height: 500px"></div>
      </div>
      <div class="w-1/2 pl-2">
        <div class="flex flex-col">
          <div class="flex flex-row">
            <div id="calendar" class="calendar-grid w-1/2 ml-1" style="height: 125px"></div>
            <div id="calendar2" class="calendar-grid w-1/2 ml-1" style="height: 125px"></div>
          </div>
          <div class="mt-2">
            <div class="solid mb-2"></div>
            <input type="text" class="grey-line-dashed" style="padding-top: -10px" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <input type="text" class="grey-line-dashed" />
            <div class="solid-red mb-2" style="padding-top: 1rem"></div>
            <div class="canvas" style="height: 295px"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="py-2" style="padding-top: 4px">
      <div class="bottom-line" style="margin-top: 4px">
      </div>
    </div>
  </div>
</div>
